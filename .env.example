# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — LA FITNESS PDV & GESTÃO COMERCIAL
# ==============================================================================
# Para conectar a um banco PostgreSQL Supabase remoto, preencha as variáveis abaixo:
# Caso não preenchidas, o sistema opera automaticamente no modo de persistência local seguro (Offline-First / PWA).

VITE_SUPABASE_URL=https://seu-projeto-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui
